  "axes": [
    {
      "id": "track",
      "cardinality": "one_primary",
      "values": [
        "llm_safety",
        "agent_safety",
        "safety_judging",
        "related_resources"
      ],
      "note": "Retain current navigation tracks; secondary targets may be recorded separately"
    },
    {
      "id": "resource_type",
      "cardinality": "one_primary",
      "note": "Retain current resource identity; do not count attacks or training data as independent benchmarks"
    },
    {
      "id": "risk_domains",
      "cardinality": "many",
      "note": "Risk coverage must be supported by actual tasks or stated evaluation scope"
    },
    {
      "id": "mechanisms",
      "cardinality": "many",
      "values": [
        "direct_jailbreak",
        "indirect_prompt_injection",
        "multimodal_injection",
        "data_or_model_poisoning",
        "extraction_or_inference_attack",
        "supply_chain_compromise",
        "tool_or_permission_misuse",
        "memory_or_retrieval_contamination",
        "goal_misgeneralization",
        "oversight_evasion",
        "multi_agent_interaction",
        "distribution_shift_or_perturbation",
        "unknown"
      ]
    },
    {
      "id": "actors",
      "cardinality": "many_or_unknown",
      "note": "Record actor roles and evidence; intent is attributed per actor, not inferred from attack presence"
    },
    {
      "id": "intent",
      "cardinality": "per_actor_or_unknown",
      "values": [
        "intentional",
        "unintentional",
        "unknown"
      ]
    },
    {
      "id": "system_context",
      "cardinality": "many",
      "note": "Separate sector, modality, language, tool environment, autonomy, multi-agent and embodied form"
    },
    {
      "id": "evaluation_protocol",
      "cardinality": "many",
      "values": [
        "mcq_knowledge_proxy",
        "generation_response_scoring",
        "static_trajectory_judgment",
        "next_action_or_plan_judgment",
        "dynamic_agent_execution",
        "human_or_system_impact_study",
        "governance_document_audit"
      ]
    },
    {
      "id": "measurement_targets",
      "cardinality": "many",
      "values": [
        "unsafe_compliance",
        "safe_helpfulness",
        "overrefusal",
