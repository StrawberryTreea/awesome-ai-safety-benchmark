        "retirement",
        "unknown"
      ]
    },
    {
      "id": "normative_profiles",
      "cardinality": "many_versioned",
      "note": "Keep jurisdiction, standard identifier, version, clause, mapping relation, evidence and applicability separate"
    },
    {
      "id": "impact_scope",
      "cardinality": "many_or_unknown",
